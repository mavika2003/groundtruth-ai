DATABASE_URL=postgresql+psycopg://groundtruth:groundtruth@localhost:5432/groundtruth
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# To use Gemini instead: MODEL_PROVIDER=gemini, GEMINI_API_KEY=<your key>,
# EMBEDDING_MODEL=gemini-embedding-001, CHAT_MODEL=gemini-3.5-flash-lite.
MODEL_PROVIDER=openai
GEMINI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_TOKEN=replace-with-a-separate-random-admin-token
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_DEMO_ENABLED=false
DEMO_DAILY_LIMIT=20
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Illustrative token rates only; replace with your provider's current prices.
INPUT_COST_PER_MILLION=0.15
OUTPUT_COST_PER_MILLION=0.60
